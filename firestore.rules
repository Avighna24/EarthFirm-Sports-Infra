rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Check if ID is clean
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to get request resources
    function incoming() {
      return request.resource.data;
    }

    match /floating_consultations/{id} {
      allow create: if isValidId(id)
        && incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 150
        && incoming().phone is string && incoming().phone.size() >= 5 && incoming().phone.size() <= 50
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && incoming().location is string && incoming().location.size() >= 2 && incoming().location.size() <= 250
        && incoming().sportType is string && incoming().sportType.size() <= 50
        && (incoming().notes == null || (incoming().notes is string && incoming().notes.size() <= 1000))
        && incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /faq_consultations/{id} {
      allow create: if isValidId(id)
        && incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 150
        && incoming().phone is string && incoming().phone.size() >= 5 && incoming().phone.size() <= 50
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && (incoming().organization == null || (incoming().organization is string && incoming().organization.size() <= 200))
        && (incoming().cityName == null || (incoming().cityName is string && incoming().cityName.size() <= 150))
        && incoming().answers is map
        && incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /budget_rfps/{id} {
      allow create: if isValidId(id)
        && incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 150
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && (incoming().phone == null || (incoming().phone is string && incoming().phone.size() <= 50))
        && incoming().location is string && incoming().location.size() >= 2 && incoming().location.size() <= 250
        && incoming().submissionCode is string && incoming().submissionCode.size() <= 50
        && (incoming().projectTotalCost is int || incoming().projectTotalCost is float)
        && incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /interactive_consultations/{id} {
      allow create: if isValidId(id)
        && incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 150
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && (incoming().phone == null || (incoming().phone is string && incoming().phone.size() <= 50))
        && incoming().location is string && incoming().location.size() >= 2 && incoming().location.size() <= 250
        && incoming().hashCode is string && incoming().hashCode.size() <= 50
        && (incoming().totalCost is int || incoming().totalCost is float)
        && incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
