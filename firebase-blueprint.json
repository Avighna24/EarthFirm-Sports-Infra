{
  "entities": {
    "FloatingConsultation": {
      "title": "FloatingConsultation",
      "description": "Consultation request from persistent floating widget",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of interested client" },
        "phone": { "type": "string", "description": "WhatsApp or active phone number" },
        "email": { "type": "string", "format": "email", "description": "Email address of client" },
        "location": { "type": "string", "description": "Project location or city" },
        "sportType": { "type": "string", "description": "Designated focus sport" },
        "notes": { "type": "string", "description": "Additional project briefs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["fullName", "phone", "email", "location"]
    },
    "FAQConsultation": {
      "title": "FAQConsultation",
      "description": "Multi-step FAQ lead generation session",
      "type": "object",
      "properties": {
        "answers": { "type": "object", "description": "Responses from the 8-step questionnaire" },
        "cityName": { "type": "string", "description": "Specific project city" },
        "fullName": { "type": "string", "description": "Contact full name" },
        "organization": { "type": "string", "description": "Client organization or school" },
        "phone": { "type": "string", "description": "WhatsApp contact number" },
        "email": { "type": "string", "format": "email", "description": "Contact email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["fullName", "email", "phone"]
    },
    "BudgetRFP": {
      "title": "BudgetRFP",
      "description": "Civil mobilization and detailed financial quote plan response",
      "type": "object",
      "properties": {
        "sportType": { "type": "string", "description": "Target sport platform ID" },
        "length": { "type": "number", "description": "Length of playfield in feet" },
        "width": { "type": "number", "description": "Width of playfield in feet" },
        "surfaceMaterial": { "type": "string", "description": "Selected sports surface key" },
        "subbase": { "type": "string", "description": "Selected civil subbase foundation key" },
        "budgetTier": { "type": "string", "description": "Target quality class" },
        "fullName": { "type": "string", "description": "Representative contact name" },
        "email": { "type": "string", "format": "email", "description": "Inbound corporate email" },
        "phone": { "type": "string", "description": "WhatsApp contact number" },
        "location": { "type": "string", "description": "Project city/state location" },
        "timeline": { "type": "string", "description": "Timeline window parameter" },
        "projectTotalCost": { "type": "number", "description": "Interactive computed total estimate in INR" },
        "submissionCode": { "type": "string", "description": "Generated unique bid ticket code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["sportType", "length", "width", "surfaceMaterial", "subbase", "fullName", "email", "location", "projectTotalCost", "submissionCode"]
    },
    "InteractiveConsultation": {
      "title": "InteractiveConsultation",
      "description": "RFP Consultations submitted via interactive designer panel",
      "type": "object",
      "properties": {
        "sportType": { "type": "string", "description": "Selected focus sport type" },
        "length": { "type": "number", "description": "Length of playfield in feet" },
        "width": { "type": "number", "description": "Width of playfield in feet" },
        "surfaceMaterial": { "type": "string", "description": "Sports surface key" },
        "subbase": { "type": "string", "description": "Subbase key" },
        "selectedSmartFeatures": { "type": "array", "description": "Selected active auxiliary features" },
        "fullName": { "type": "string", "description": "Representative client name" },
        "email": { "type": "string", "format": "email", "description": "Corporate client email" },
        "phone": { "type": "string", "description": "WhatsApp contact number" },
        "location": { "type": "string", "description": "Project location" },
        "intendedUse": { "type": "string", "description": "Intended user group" },
        "timeline": { "type": "string", "description": "Target timeline" },
        "additionalNotes": { "type": "string", "description": "Notes" },
        "totalCost": { "type": "number", "description": "Calculated baseline cost in INR" },
        "hashCode": { "type": "string", "description": "Consultation confirmation reference code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["fullName", "email", "location", "totalCost", "hashCode"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Job career application submitted by potential candidate",
      "type": "object",
      "properties": {
        "roleId": { "type": "string", "description": "Candidate target role ID" },
        "roleTitle": { "type": "string", "description": "Display title of targeted job" },
        "fullName": { "type": "string", "description": "Full legal name of candidate" },
        "email": { "type": "string", "format": "email", "description": "Candidate email address" },
        "phone": { "type": "string", "description": "Candidate telephone contact" },
        "experienceYear": { "type": "string", "description": "Self-selected experience band or years" },
        "coverLetter": { "type": "string", "description": "Detailed pitch or professional cover note" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Local ISO creation time" }
      },
      "required": ["roleId", "roleTitle", "fullName", "email", "phone", "experienceYear", "coverLetter"]
    }
  },
  "firestore": {
    "/floating_consultations/{id}": {
      "schema": "FloatingConsultation",
      "description": "Submissions from main floating quick-consult form"
    },
    "/faq_consultations/{id}": {
      "schema": "FAQConsultation",
      "description": "Submissions from 8-step project wizard screen"
    },
    "/budget_rfps/{id}": {
      "schema": "BudgetRFP",
      "description": "Submissions from budget estimator spreadsheet calculator"
    },
    "/interactive_consultations/{id}": {
      "schema": "InteractiveConsultation",
      "description": "Submissions on customizer RFP panel"
    },
    "/job_applications/{id}": {
      "schema": "JobApplication",
      "description": "Submitted job applications for Earthfirm sports construction positions"
    }
  }
}
